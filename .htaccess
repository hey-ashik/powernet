# ==========================================================
# PowerNet Clean URL & Apache mod_rewrite Configuration
# Enables URLs like: powernet.ashik.com/register
# ==========================================================

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # 1. API Execution with .php extension: /api/xxx.php -> backend/api/xxx.php
    RewriteRule ^api/(.+\.php)$ backend/api/$1 [L,QSA]

    # 2. Clean API URLs without .php extension: /api/xxx -> backend/api/xxx.php
    RewriteRule ^api/([^.?]+)$ backend/api/$1.php [L,QSA]

    # 3. Handle Frontend Clean URLs without .html
    RewriteRule ^$ frontend/index.html [L]
    RewriteRule ^register/?$ frontend/register.html [L]
    RewriteRule ^login/?$ frontend/login.html [L]
    RewriteRule ^dashboard/?$ frontend/dashboard.html [L]
    RewriteRule ^devices/?$ frontend/devices.html [L]
    RewriteRule ^analytics/?$ frontend/analytics.html [L]
    RewriteRule ^logs/?$ frontend/dashboard.html [L]
    RewriteRule ^verify-email/?$ frontend/verify-email.html [L]
    RewriteRule ^forgot-password/?$ frontend/forgot-password.html [L]
    RewriteRule ^reset-password/?$ frontend/reset-password.html [L]

    # 4. Serve existing physical files and directories directly
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # 5. Fallback for SPA routing
    RewriteRule ^(.*)$ frontend/dashboard.html [L]
</IfModule>

# Security Headers & MIME Types
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

# Deny access to sensitive files and directories
<FilesMatch "^\.env|\.git|\.md$|composer\.(json|lock)$">
    Order allow,deny
    Deny from all
</FilesMatch>
